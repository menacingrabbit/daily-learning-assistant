# OpenRouter (bring-your-own key / model)
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-4.6

# Telegram bot (create one via @BotFather, ~2 minutes)
TELEGRAM_BOT_TOKEN=
# Numeric chat id — send any message to your bot, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it.
TELEGRAM_CHAT_ID=

# Optional: location of the SQLite file (defaults to ./data/db.sqlite)
# DB_PATH=data/db.sqlite