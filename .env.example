# OpenRouter (bring-your-own key / model)
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-4.6

# Telegram bot (create one via @BotFather, ~2 minutes)
TELEGRAM_BOT_TOKEN=
# Numeric chat id — send any message to your bot, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it.
TELEGRAM_CHAT_ID=

# Optional: location of the SQLite file (defaults to ./data/db.sqlite)
# DB_PATH=data/db.sqlite

# Optional: host folder mounted at /app/data (defaults to ./data).
# On a server, point this outside the checkout so the database survives
# re-clones and redeploys, e.g. DATA_DIR=/var/lib/dla
# DATA_DIR=./data

# Optional: run a prebuilt image instead of building locally. Only needed on a
# server that pulls from a registry (see README, "Running it in the cloud").
# IMAGE=us-west1-docker.pkg.dev/PROJECT/dla/daily-learning:latest