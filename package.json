{
  "name": "daily-learning-assistant",
  "version": "1.0.0",
  "description": "Self-hostable agent that builds a daily learning habit: reminds, checks recap, generates sized topics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "once": "tsx src/index.ts --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "testrun": "tsx src/index.ts --testrun",
    "list": "tsx src/index.ts --list"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "node-cron": "^4.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
